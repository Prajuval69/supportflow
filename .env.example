# Copy to backend/.env for local settings. Never commit actual credentials.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=supportflow
# PGPASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
# Set DEMO_PASSWORD explicitly outside development; seeds refuse production.
# DEMO_PASSWORD=choose-a-local-demo-password
# Production only: SECRET_KEY_BASE and ALLOWED_HOSTS are required.
